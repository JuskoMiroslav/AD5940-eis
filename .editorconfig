# EditorConfig is awesome: https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Indentation size (width of a single indent)
indent_style = space
indent_size = 2

# "Newline width" / Maximum line length
max_line_length = 20

